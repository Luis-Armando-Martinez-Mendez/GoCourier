@model GoCourier.Domain.Entities.Notificacion

@{
    ViewData["Title"] = "Crear Notificación";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-bell-fill"></i> Crear Nueva Notificación
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle"></i> Volver a la lista
        </a>
    </div>

    <div class="card shadow-sm rounded">
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="UsuarioId" class="form-label fw-bold">Correo del Usuario</label>
                    <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.Usuarios"></select>
                    <span asp-validation-for="UsuarioId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Mensaje" class="form-label fw-bold"></label>
                    <textarea asp-for="Mensaje" class="form-control" rows="3" placeholder="Ingrese el mensaje"></textarea>
                    <span asp-validation-for="Mensaje" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Fecha" class="form-label fw-bold"></label>
                    <input asp-for="Fecha" type="datetime-local" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Crear
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>