@{
    ViewData["Title"] = "Inicio";
}


<div class="bg-dark text-warning text-center py-5 mb-5">
    <h1 class="display-3 fw-bold">GoCourier</h1>
    <p class="lead">La forma más rápida y confiable de gestionar tus envíos</p>
</div>


<div class="container text-center">
    <div class="row justify-content-center g-4">
        <div class="col-6 col-md-3">
            <a href="/Usuario" class="btn btn-outline-warning btn-lg w-100 py-4 d-flex flex-column align-items-center">
                <i class="bi bi-person-circle fs-1 mb-2"></i>
                <span class="fw-bold">Usuarios</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/Envio" class="btn btn-outline-warning btn-lg w-100 py-4 d-flex flex-column align-items-center">
                <i class="bi bi-truck fs-1 mb-2"></i>
                <span class="fw-bold">Envíos</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/Notificacion" class="btn btn-outline-warning btn-lg w-100 py-4 d-flex flex-column align-items-center">
                <i class="bi bi-bell-fill fs-1 mb-2"></i>
                <span class="fw-bold">Notificaciones</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/Buscador" class="btn btn-outline-warning btn-lg w-100 py-4 d-flex flex-column align-items-center">
                <i class="bi bi-search fs-1 mb-2"></i>
                <span class="fw-bold">Buscador</span>
            </a>
        </div>
    </div>
</div>

