@model GoCourier.Domain.Entities.Envio

@{
    ViewData["Title"] = "Detalles del Envío";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-truck"></i> Detalles del Envío
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle"></i> Volver a la lista
        </a>
    </div>

    <div class="card shadow-sm rounded">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 fw-bold text-secondary">Usuario</dt>
                <dd class="col-sm-9">@Model.Usuario?.Email</dd>

                <dt class="col-sm-3 fw-bold text-secondary">@Html.DisplayNameFor(model => model.Direccion)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Direccion)</dd>

                <dt class="col-sm-3 fw-bold text-secondary">@Html.DisplayNameFor(model => model.Descripcion)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

                <dt class="col-sm-3 fw-bold text-secondary">@Html.DisplayNameFor(model => model.Estado)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Estado)</dd>

                <dt class="col-sm-3 fw-bold text-secondary">@Html.DisplayNameFor(model => model.Fecha)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Fecha)</dd>
            </dl>
        </div>
    </div>

     <div class="mt-4 d-flex justify-content-end">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning me-2">
            <i class="bi bi-pencil-square"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle"></i> Volver a la lista
        </a>
    </div>
</div>